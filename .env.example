APP_NAME="Loop RAG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://looprag.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Other projects use this key to call Loop RAG.
AI_GATEWAY_API_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Any OpenAI-compatible server: Ollama, vLLM, LM Studio or a cloud gateway.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen3:4b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=120
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# === LOOP Central AI Dispatcher ===
# LoopRouter is the single entry point for every AI call
# (embed/chat/extract/summary/rerank/answer/chat_direct): it applies
# model routing, rate limits, circuit breaking, and usage recording.
LOOP_DEFAULT_PROVIDER=openai_compatible

# Multi-model switching strategy for candidate chains:
#   failover    - try candidates in order, switch to the next on failure
#   round_robin - rotate the starting candidate per request (load spread),
#                 still failing over within one request
#   single      - only ever use the first candidate
LOOP_DEFAULT_STRATEGY=failover

LOOP_STREAM=false
LOOP_CACHE_TTL=3600
LOOP_RETRY_TIMES=2
LOOP_RETRY_SLEEP_MS=300
LOOP_RPM=0
LOOP_TPM=0
LOOP_CONCURRENCY=0
LOOP_CB_FAILURE_THRESHOLD=5
LOOP_CB_COOLDOWN=30
LOOP_RECORD=true
LOOP_RECORD_SAMPLE=1.0
LOOP_EMBED_PROVIDER=openai_compatible
LOOP_CHAT_PROVIDER=openai_compatible
LOOP_EXTRACT_PROVIDER=openai_compatible
LOOP_SUMMARY_PROVIDER=openai_compatible
LOOP_RERANK_PROVIDER=openai_compatible
LOOP_ANSWER_PROVIDER=openai_compatible
LOOP_CHAT_DIRECT_PROVIDER=openai_compatible

# Automatic model switching: per-task candidate chains.
# Format: comma separated `provider@model` entries; later entries are the
# automatic fallbacks. Leave unset to use the single LOOP_*_PROVIDER +
# LLM_*_MODEL defaults above.
# LOOP_ANSWER_CANDIDATES="openai_compatible@qwen3:4b,backup@qwen2.5:7b"
# LOOP_EMBED_CANDIDATES="openai_compatible@nomic-embed-text"
# LOOP_CHAT_CANDIDATES=
# LOOP_EXTRACT_CANDIDATES=
# LOOP_SUMMARY_CANDIDATES=
# LOOP_RERANK_CANDIDATES=
# LOOP_CHAT_DIRECT_CANDIDATES=

# Optional second provider referenced as `backup@<model>` in candidate
# chains. Any OpenAI-compatible server works (Ollama, vLLM, LM Studio,
# a cloud gateway). Leave empty to disable the backup provider.
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=ollama
LLM_BACKUP_TIMEOUT=120

# Health probes: `loop:health` runs on the scheduler and a provider whose
# latest probe failed within this TTL is moved to the back of its chain.
LOOP_HEALTH_TTL=300

GRAPH_RAG_ENABLED=false
# Louvain hierarchy depth for community detection: 1 = only the finest
# partition, higher values add condensed summary levels on top.
GRAPH_RAG_COMMUNITY_LEVELS=2
GRAPH_RAG_EXTRACTION_MODEL=qwen3:4b
GRAPH_RAG_SUMMARY_MODEL=qwen3:4b
GRAPH_RAG_MAX_NODES=50
GRAPH_RAG_RERANK_ENABLED=false
GRAPH_RAG_RERANK_MODEL=qwen3:4b
GRAPH_RAG_RERANK_CANDIDATES=20
GRAPH_RAG_SEMANTIC_ENTITY_RESOLUTION=false
GRAPH_RAG_ENTITY_SIMILARITY_THRESHOLD=0.92
GRAPH_RAG_ENTITY_SIMILARITY_MARGIN=0.05
